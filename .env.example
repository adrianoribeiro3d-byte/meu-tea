# Porta HTTP
PORT=3000
# Em produção use "production" (ativa cookie Secure — exige HTTPS)
NODE_ENV=development
# Pasta do banco de dados. Padrão: ./data (desenvolvimento) ou ~/neuro-sistema-dados (produção)
# NEUROSISTEMA_DADOS=
# Palavra-chave que libera a página /instalacao para criar o primeiro administrador
NEUROSISTEMA_TOKEN_INSTALACAO=
# Atrás de proxy/hospedagem (Hostinger, Render): 1
TRUST_PROXY=
# Chave mestra (32 bytes em hex) para criptografar dados pessoais no banco.
# Opcional: sem ela, uma chave é gerada e guardada em <pasta de dados>/.chave-mestra.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUARDE EM LOCAL SEGURO: sem ela os dados criptografados não podem ser lidos.
NEUROSISTEMA_MASTER_KEY=
# Grupos com menos crianças que este número são agregados em "Outros" no dashboard
# (reduz risco de reidentificação). 0 desativa.
LGPD_MIN_GRUPO=3
# Tempo máximo de inatividade da sessão, em minutos
SESSAO_MINUTOS=30

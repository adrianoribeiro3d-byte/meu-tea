<%- include('partials/cabeca', { titulo: 'Esqueci minha senha' }) %>
<body>
<main class="centro">
  <div class="caixa-login">
    <div class="marca"><%- include('partials/logo') %></div>
    <div class="cartao">
      <h1>Esqueci minha senha</h1>
      <% if (!emailAtivo) { %>
        <p class="sub">Peça ao administrador do sistema na Secretaria para enviar a você um link de redefinição de senha.</p>
      <% } else if (enviado) { %>
        <div class="aviso ok" role="status">Se este e-mail estiver cadastrado e ativo, você vai receber em instantes um link para criar uma senha nova. O link vale por 30 minutos. Confira também a caixa de spam.</div>
      <% } else { %>
        <p class="sub">Informe o e-mail do seu acesso. Enviaremos um link para você criar uma senha nova.</p>
        <% if (erro) { %><div class="aviso erro" role="alert"><%= erro %></div><% } %>
        <form method="post" action="/esqueci">
          <div class="campo"><label for="email">E-mail</label><input type="email" id="email" name="email" autocomplete="username" required autofocus></div>
          <button type="submit" class="primario" style="width:100%;justify-content:center">Enviar link</button>
        </form>
      <% } %>
    </div>
    <p class="pequeno" style="text-align:center;margin-top:16px"><a href="/login">← Voltar ao login</a></p>
  </div>
</main>
</body>
</html>

<%- include('partials/cabeca', { titulo: 'Entrar' }) %>
<body>
<% if (demo) { %><div role="note" style="background:#fff3d6;color:#6b4500;border-bottom:1px solid #f0d58a;padding:8px 16px;text-align:center;font-size:.85rem;font-weight:600">Ambiente de DEMONSTRAÇÃO com dados fictícios — não cadastre dados reais de crianças aqui.</div><% } %>
<main class="centro">
  <div class="caixa-login">
    <div class="marca"><%- include('partials/logo') %> Meu TEA</div>
    <p class="sub" style="text-align:center">Acompanhamento de crianças neurodivergentes</p>
    <% if (demo) { %><div class="aviso info pequeno">Demonstração: entre com <strong>admin@meutea.demo</strong> (Secretaria) ou <strong>fono@meutea.demo</strong> (profissional).<br><%= demoSenhaPadrao ? 'Senha: demo12345678' : 'Use a senha definida na criação do ambiente.' %></div><% } %>
    <div class="cartao">
      <% if (erro) { %><div class="aviso erro" role="alert"><%= erro %></div><% } %>
      <form method="post" action="/login">
        <div class="campo">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
        </div>
        <div class="campo">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" autocomplete="current-password" required>
        </div>
        <button type="submit" class="primario" style="width:100%;justify-content:center">Entrar</button>
      </form>
    </div>
    <p class="pequeno muted" style="text-align:center;margin-top:16px">
      Acesso restrito a profissionais autorizados.<br>
      Todos os acessos são registrados conforme a LGPD (Lei 13.709/2018). · <a href="/privacidade">Privacidade</a>
    </p>
  </div>
</main>
</body>
</html>
